PORT=3000
DATABASE_URL=postgresql://konti:konti@localhost:5432/konti
# Obligatorio, ≥32 caracteres. Sin placeholders (la API no arranca sin él).
JWT_SECRET=local-dev-jwt-secret-konti-min-32b!
# Access TTL corto (SEC-02); revocación efectiva vía familyId en AuthGuard.
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:4200

# SEC-01 rate limiting (in-memory por proceso; ver docs/audits/auth-hardening-fixes.md)
AUTH_RATE_LIMIT_ENABLED=true
AUTH_LOGIN_IP_MAX=30
AUTH_LOGIN_IP_WINDOW_MS=60000
AUTH_LOGIN_ACCOUNT_MAX=10
AUTH_LOGIN_ACCOUNT_WINDOW_MS=900000
AUTH_REFRESH_IP_MAX=60
AUTH_REFRESH_IP_WINDOW_MS=60000
# Cache opcional de presencia de familia (0 = off; invalidate post-logout)
AUTH_SESSION_CACHE_TTL_MS=0

# console | better_stack | both
LOG_PROVIDER=console
BETTER_STACK_SOURCE_TOKEN=
# Host del source (Better Stack → Sources → Ingesting). Ej. regional:
# https://sXXXX.us-west-2a.betterstackdata.com
BETTER_STACK_ENDPOINT=https://in.logs.betterstack.com
