generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum InventoryMovementType {
  ENTRY
  EXIT
  ADJUSTMENT
  RETURN
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum EntityStatus {
  ACTIVE
  INACTIVE
}

enum CustomerType {
  PERSON
  COMPANY
}

enum MileageSource {
  SERVICE_ORDER
  MANUAL
  IMPORT
}

model Business {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships UserBusinessMembership[]
  products    Product[]
  movements   InventoryMovement[]
  customers   Customer[]
  vehicles    Vehicle[]
  fleets      Fleet[]
  fleetVehicles FleetVehicle[]
  mileageLogs VehicleMileageLog[]
  auditLogs   AuditLog[]

  @@map("businesses")
}

model User {
  id           String           @id @default(uuid()) @db.Uuid
  email        String           @unique
  fullName     String           @map("full_name")
  passwordHash String           @map("password_hash")
  status       MembershipStatus @default(ACTIVE)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships     UserBusinessMembership[]
  refreshSessions AuthRefreshSession[]

  @@map("users")
}

/// Sesión de refresh (solo hash). familyId agrupa rotaciones; reuso revoca la familia.
model AuthRefreshSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  familyId         String    @map("family_id") @db.Uuid
  tokenHash        String    @unique @map("token_hash") @db.VarChar(64)
  activeBusinessId String    @map("active_business_id") @db.Uuid
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedById     String?   @map("replaced_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("auth_refresh_sessions")
}

model UserBusinessMembership {
  userId      String           @map("user_id") @db.Uuid
  businessId  String           @map("business_id") @db.Uuid
  roleCodes   String[]         @map("role_codes")
  permissions String[]
  status      MembershipStatus @default(ACTIVE)

  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@id([userId, businessId])
  @@map("user_business_roles")
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  businessId  String        @map("business_id") @db.Uuid
  sku         String        @db.VarChar(80)
  name        String        @db.VarChar(180)
  description String?
  unit        String        @db.VarChar(30)
  categoryId  String?       @map("category_id") @db.Uuid
  /// CHECK products_stock_non_negative en SQL — ver docs/db-constraints.md
  stock       Decimal       @default(0) @db.Decimal(14, 3)
  /// CHECK products_min_stock_non_negative en SQL — ver docs/db-constraints.md
  minStock    Decimal       @default(0) @map("min_stock") @db.Decimal(14, 3)
  salePrice   Decimal?      @map("sale_price") @db.Decimal(14, 2)
  status      ProductStatus @default(ACTIVE)
  version     Int           @default(1)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy   String?       @map("created_by") @db.Uuid
  updatedBy   String?       @map("updated_by") @db.Uuid

  business  Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  movements InventoryMovement[]

  /// H-07 Fase 1: soporte para FK compuestas (business_id, id)
  @@unique([businessId, id])
  @@unique([businessId, sku])
  @@index([businessId, status])
  @@index([businessId, name])
  @@map("products")
}

model InventoryMovement {
  id                 String                 @id @default(uuid()) @db.Uuid
  businessId         String                 @map("business_id") @db.Uuid
  productId          String                 @map("product_id") @db.Uuid
  type               InventoryMovementType
  /// CHECK inventory_movements_quantity_valid en SQL — ver docs/db-constraints.md
  quantity           Decimal                @db.Decimal(14, 3)
  stockBefore        Decimal                @map("stock_before") @db.Decimal(14, 3)
  /// CHECK inventory_movements_stock_after_non_negative en SQL — ver docs/db-constraints.md
  stockAfter         Decimal                @map("stock_after") @db.Decimal(14, 3)
  reason             String?                @db.VarChar(500)
  relatedEntityType  String?                @map("related_entity_type") @db.VarChar(50)
  relatedEntityId    String?                @map("related_entity_id") @db.Uuid
  operationKey       String?                @map("operation_key") @db.VarChar(180)
  reversesMovementId String?                @map("reverses_movement_id") @db.Uuid
  createdBy          String                 @map("created_by") @db.Uuid
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  business Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  /// H-07 Fase 2: FK compuesta tenant (SQL NOT VALID; FK simple product_id se conserva en PG)
  product  Product            @relation(fields: [businessId, productId], references: [businessId, id], onDelete: Restrict)
  /// H-07 Fase 4: self-FK tenant (SQL NOT VALID; FK simple reverses_movement_id se conserva en PG)
  reverses InventoryMovement?  @relation("MovementReversal", fields: [businessId, reversesMovementId], references: [businessId, id], onDelete: Restrict)
  reversed InventoryMovement[] @relation("MovementReversal")

  /// H-07 Fase 1: soporte para FK compuestas (business_id, id) incl. self-FK
  @@unique([businessId, id])
  @@unique([businessId, operationKey])
  @@index([businessId, createdAt(sort: Desc)])
  @@index([businessId, productId, createdAt(sort: Desc)])
  @@map("inventory_movements")
}

/// Unicidad parcial documento/NIT en SQL (índices parciales) — docs/db-constraints.md
model Customer {
  id             String       @id @default(uuid()) @db.Uuid
  businessId     String       @map("business_id") @db.Uuid
  type           CustomerType
  status         EntityStatus @default(ACTIVE)
  documentType   String?      @map("document_type") @db.VarChar(20)
  documentNumber String?      @map("document_number") @db.VarChar(40)
  firstName      String?      @map("first_name") @db.VarChar(120)
  lastName       String?      @map("last_name") @db.VarChar(120)
  nit            String?      @db.VarChar(30)
  legalName      String?      @map("legal_name") @db.VarChar(180)
  tradeName      String?      @map("trade_name") @db.VarChar(180)
  contactName    String?      @map("contact_name") @db.VarChar(180)
  phone          String?      @db.VarChar(40)
  email          String?      @db.VarChar(180)
  address        String?      @db.VarChar(240)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?      @map("created_by") @db.Uuid
  updatedBy      String?      @map("updated_by") @db.Uuid

  business Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  vehicles Vehicle[]
  fleets   Fleet[]

  /// H-07 Fase 1: soporte para FK compuestas (business_id, id)
  @@unique([businessId, id])
  @@index([businessId, status])
  @@index([businessId, type])
  @@index([businessId, email])
  @@map("customers")
}

model Vehicle {
  id             String       @id @default(uuid()) @db.Uuid
  businessId     String       @map("business_id") @db.Uuid
  customerId     String       @map("customer_id") @db.Uuid
  fleetId        String?      @map("fleet_id") @db.Uuid
  plate          String       @db.VarChar(20)
  vin            String?      @db.VarChar(40)
  brand          String       @db.VarChar(80)
  line           String       @db.VarChar(80)
  model          String?      @db.VarChar(80)
  year           Int?
  vehicleType    String?      @map("vehicle_type") @db.VarChar(40)
  color          String?      @db.VarChar(40)
  fuelType       String?      @map("fuel_type") @db.VarChar(40)
  engineCapacity String?      @map("engine_capacity") @db.VarChar(20)
  version        String?      @db.VarChar(80)
  /// CHECK vehicles_mileage_non_negative en SQL — ver docs/db-constraints.md
  currentMileage Int          @default(0) @map("current_mileage")
  status         EntityStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?      @map("created_by") @db.Uuid
  updatedBy      String?      @map("updated_by") @db.Uuid

  business    Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  /// H-07 Fase 2: FK compuesta tenant (SQL NOT VALID; FK simple customer_id se conserva en PG)
  customer    Customer             @relation(fields: [businessId, customerId], references: [businessId, id], onDelete: Restrict)
  /// H-07 Fase 4: proyección flota tenant (SQL NOT VALID; FK simple fleet_id se conserva en PG). Nullable = sin flota.
  fleet       Fleet?               @relation(fields: [businessId, fleetId], references: [businessId, id], onDelete: Restrict)
  mileageLogs VehicleMileageLog[]
  assignments FleetVehicle[]

  /// H-07 Fase 1: soporte para FK compuestas (business_id, id)
  @@unique([businessId, id])
  @@unique([businessId, plate])
  @@index([businessId, customerId])
  @@index([businessId, fleetId])
  @@index([businessId, status])
  @@map("vehicles")
}

model VehicleMileageLog {
  id         String        @id @default(uuid()) @db.Uuid
  businessId String        @map("business_id") @db.Uuid
  vehicleId  String        @map("vehicle_id") @db.Uuid
  /// CHECK vehicle_mileage_logs_mileage_non_negative en SQL — ver docs/db-constraints.md
  mileage    Int
  recordedAt DateTime      @default(now()) @map("recorded_at") @db.Timestamptz(6)
  source     MileageSource
  sourceId   String?       @map("source_id") @db.Uuid
  recordedBy String?       @map("recorded_by") @db.Uuid

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  /// H-07 Fase 2: FK compuesta tenant (SQL NOT VALID; FK simple vehicle_id se conserva en PG)
  vehicle  Vehicle  @relation(fields: [businessId, vehicleId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, vehicleId, recordedAt(sort: Desc)])
  @@map("vehicle_mileage_logs")
}

model Fleet {
  id          String       @id @default(uuid()) @db.Uuid
  businessId  String       @map("business_id") @db.Uuid
  customerId  String       @map("customer_id") @db.Uuid
  name        String       @db.VarChar(180)
  description String?
  status      EntityStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy   String?      @map("created_by") @db.Uuid
  updatedBy   String?      @map("updated_by") @db.Uuid

  business    Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  /// H-07 Fase 2: FK compuesta tenant (SQL NOT VALID; FK simple customer_id se conserva en PG)
  customer    Customer       @relation(fields: [businessId, customerId], references: [businessId, id], onDelete: Restrict)
  vehicles    Vehicle[]
  assignments FleetVehicle[]

  /// H-07 Fase 1: soporte para FK compuestas (business_id, id)
  @@unique([businessId, id])
  @@index([businessId, customerId])
  @@index([businessId, status])
  @@index([businessId, name])
  @@map("fleets")
}

/// UNIQUE parcial fleet_vehicles_open_assignment_unique (unassigned_at IS NULL) — docs/db-constraints.md
model FleetVehicle {
  id           String    @id @default(uuid()) @db.Uuid
  businessId   String    @map("business_id") @db.Uuid
  fleetId      String    @map("fleet_id") @db.Uuid
  vehicleId    String    @map("vehicle_id") @db.Uuid
  assignedAt   DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)
  unassignedAt DateTime? @map("unassigned_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  /// H-07 Fase 2: FK compuestas tenant (SQL NOT VALID; FK simples se conservan en PG)
  fleet    Fleet    @relation(fields: [businessId, fleetId], references: [businessId, id], onDelete: Restrict)
  vehicle  Vehicle  @relation(fields: [businessId, vehicleId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, fleetId])
  @@index([businessId, vehicleId])
  @@map("fleet_vehicles")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id") @db.Uuid
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([businessId, createdAt(sort: Desc)])
  @@map("audit_logs")
}
