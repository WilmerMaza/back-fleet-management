generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum InventoryMovementType {
  ENTRY
  EXIT
  ADJUSTMENT
  RETURN
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum EntityStatus {
  ACTIVE
  INACTIVE
}

/// Estado operativo del tenant (empresa contratante de KONTI).
enum BusinessStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum RegistrationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Rol de plataforma (no depende de membresía de taller).
enum PlatformRole {
  SUPER_ADMIN
}

enum AuthProvider {
  GOOGLE
  LOCAL
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum CustomerType {
  PERSON
  COMPANY
}

enum MileageSource {
  SERVICE_ORDER
  MANUAL
  IMPORT
}

enum ServiceOrderStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MaintenanceRuleType {
  MILEAGE
  TIME
  WHICHEVER_FIRST
  CUSTOM
}

model Business {
  id        String         @id @default(uuid()) @db.Uuid
  name      String
  legalName String?        @map("legal_name")
  taxId     String?        @map("tax_id") @db.VarChar(32)
  email     String?
  phone     String?        @db.VarChar(40)
  address   String?
  status    BusinessStatus @default(ACTIVE)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships            UserBusinessMembership[]
  roles                    Role[]
  invitations              Invitation[]
  registrationRequest      BusinessRegistrationRequest?
  products      Product[]
  productCategories ProductCategory[]
  productBrands     ProductBrand[]
  movements         InventoryMovement[]
  purchaseReceipts  PurchaseReceipt[]
  customers     Customer[]
  vehicles      Vehicle[]
  fleets        Fleet[]
  fleetVehicles FleetVehicle[]
  mileageLogs   VehicleMileageLog[]
  serviceTypes  ServiceType[]
  serviceOrders ServiceOrder[]
  serviceOrderItems ServiceOrderItem[]
  serviceOrderProductUsages ServiceOrderProductUsage[]
  auditLogs     AuditLog[]

  @@unique([taxId])
  @@map("businesses")
}

model User {
  id           String           @id @default(uuid()) @db.Uuid
  email        String           @unique
  fullName     String           @map("full_name")
  /// Null si la cuenta solo tiene identidad externa (p. ej. Google) y aún no fijó contraseña.
  passwordHash String?          @map("password_hash")
  status       MembershipStatus @default(ACTIVE)
  platformRole PlatformRole?    @map("platform_role")
  /// Preferencias personales de notificación (no afectan correos de seguridad obligatorios).
  notificationPreferences Json? @map("notification_preferences")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships     UserBusinessMembership[]
  refreshSessions AuthRefreshSession[]
  identities      AuthIdentity[]
  invitationsSent              Invitation[]                    @relation("InvitationInvitedBy")
  registrationRequestsApplied  BusinessRegistrationRequest[]   @relation("RegistrationApplicant")
  registrationRequestsReviewed BusinessRegistrationRequest[] @relation("RegistrationReviewer")

  @@map("users")
}

/// Solicitud de alta de empresa (desacoplada del ciclo operativo del tenant).
model BusinessRegistrationRequest {
  id                String                    @id @default(uuid()) @db.Uuid
  businessId        String                    @unique @map("business_id") @db.Uuid
  applicantUserId   String                    @map("applicant_user_id") @db.Uuid
  status            RegistrationRequestStatus @default(PENDING)
  reviewedByUserId  String?                   @map("reviewed_by_user_id") @db.Uuid
  reviewedAt        DateTime?                 @map("reviewed_at") @db.Timestamptz(6)
  rejectionReason   String?                   @map("rejection_reason") @db.VarChar(500)
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  business    Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  applicant   User     @relation("RegistrationApplicant", fields: [applicantUserId], references: [id], onDelete: Restrict)
  reviewedBy  User?    @relation("RegistrationReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)

  @@index([status, createdAt(sort: Desc)])
  @@map("business_registration_requests")
}

/// Invitación a un negocio. Se guarda hash del token, no el token en claro.
model Invitation {
  id          String           @id @default(uuid()) @db.Uuid
  businessId  String           @map("business_id") @db.Uuid
  email       String           @db.VarChar(255)
  roleCode    String           @map("role_code") @db.VarChar(60)
  tokenHash   String           @unique @map("token_hash") @db.VarChar(64)
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime         @map("expires_at") @db.Timestamptz(6)
  invitedById String           @map("invited_by_id") @db.Uuid
  acceptedAt  DateTime?        @map("accepted_at") @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  business  Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  invitedBy User     @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([businessId, status])
  @@index([email])
  @@map("invitations")
}

/// Identidad externa (OIDC). Google usa `sub` como providerUserId.
model AuthIdentity {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  provider       AuthProvider
  providerUserId String       @map("provider_user_id") @db.VarChar(255)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_identities")
}

/// Catálogo global de permisos (código estable).
model Permission {
  id          String @id @default(uuid()) @db.Uuid
  code        String @unique @db.VarChar(80)
  description String @db.VarChar(255)
  module      String @db.VarChar(60)

  roles RolePermission[]

  @@map("permissions")
}

/// Rol de plataforma (businessId null) o de un negocio.
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String?  @map("business_id") @db.Uuid
  code        String   @db.VarChar(60)
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(255)
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  business    Business?        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  permissions RolePermission[]

  @@index([businessId])
  @@map("roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Sesión de refresh (solo hash). familyId agrupa rotaciones; reuso revoca la familia.
/// `activeBusinessId` null = sesión solo de plataforma (SUPER_ADMIN sin tenant activo).
model AuthRefreshSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  familyId         String    @map("family_id") @db.Uuid
  tokenHash        String    @unique @map("token_hash") @db.VarChar(64)
  activeBusinessId String?   @map("active_business_id") @db.Uuid
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedById     String?   @map("replaced_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("auth_refresh_sessions")
}

model UserBusinessMembership {
  userId      String           @map("user_id") @db.Uuid
  businessId  String           @map("business_id") @db.Uuid
  roleCodes   String[]         @map("role_codes")
  permissions String[]
  status      MembershipStatus @default(ACTIVE)

  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@id([userId, businessId])
  @@map("user_business_roles")
}

/// Categoría / subcategoría de producto (máx. 2 niveles vía parentId).
model ProductCategory {
  id             String   @id @default(uuid()) @db.Uuid
  businessId     String   @map("business_id") @db.Uuid
  name           String   @db.VarChar(120)
  normalizedName String   @map("normalized_name") @db.VarChar(120)
  code           String?  @db.VarChar(40)
  description    String?
  parentId       String?  @map("parent_id") @db.Uuid
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?  @map("created_by") @db.Uuid
  updatedBy      String?  @map("updated_by") @db.Uuid

  business Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  parent   ProductCategory? @relation("CategoryTree", fields: [businessId, parentId], references: [businessId, id], onDelete: Restrict)
  children ProductCategory[] @relation("CategoryTree")
  products Product[]

  @@unique([businessId, id])
  @@unique([businessId, normalizedName])
  @@index([businessId, parentId])
  @@index([businessId, isActive])
  @@map("product_categories")
}

/// Marca de producto (catálogo independiente de categorías).
model ProductBrand {
  id             String   @id @default(uuid()) @db.Uuid
  businessId     String   @map("business_id") @db.Uuid
  name           String   @db.VarChar(120)
  normalizedName String   @map("normalized_name") @db.VarChar(120)
  description    String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?  @map("created_by") @db.Uuid
  updatedBy      String?  @map("updated_by") @db.Uuid

  business Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  products Product[]

  @@unique([businessId, id])
  @@unique([businessId, normalizedName])
  @@index([businessId, isActive])
  @@map("product_brands")
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  businessId  String        @map("business_id") @db.Uuid
  sku         String        @db.VarChar(80)
  name        String        @db.VarChar(180)
  description String?
  unit        String        @db.VarChar(30)
  /// Hoja de clasificación: categoría raíz o subcategoría (máx. 2 niveles).
  categoryId  String?       @map("category_id") @db.Uuid
  brandId     String?       @map("brand_id") @db.Uuid
  /// CHECK products_stock_non_negative en SQL — ver docs/db-constraints.md
  stock       Decimal       @default(0) @db.Decimal(14, 3)
  /// CHECK products_min_stock_non_negative en SQL — ver docs/db-constraints.md
  minStock    Decimal       @default(0) @map("min_stock") @db.Decimal(14, 3)
  salePrice   Decimal?      @map("sale_price") @db.Decimal(14, 2)
  status      ProductStatus @default(ACTIVE)
  version     Int           @default(1)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy   String?       @map("created_by") @db.Uuid
  updatedBy   String?       @map("updated_by") @db.Uuid

  business  Business                    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  category  ProductCategory?            @relation(fields: [businessId, categoryId], references: [businessId, id], onDelete: Restrict)
  brand     ProductBrand?               @relation(fields: [businessId, brandId], references: [businessId, id], onDelete: Restrict)
  movements InventoryMovement[]
  orderUsages ServiceOrderProductUsage[]

  /// H-07 Fase 1: soporte para FK compuestas (business_id, id)
  @@unique([businessId, id])
  @@unique([businessId, sku])
  @@index([businessId, status])
  @@index([businessId, name])
  @@index([businessId, categoryId])
  @@index([businessId, brandId])
  @@map("products")
}

model InventoryMovement {
  id                 String                 @id @default(uuid()) @db.Uuid
  businessId         String                 @map("business_id") @db.Uuid
  productId          String                 @map("product_id") @db.Uuid
  type               InventoryMovementType
  /// CHECK inventory_movements_quantity_valid en SQL — ver docs/db-constraints.md
  quantity           Decimal                @db.Decimal(14, 3)
  stockBefore        Decimal                @map("stock_before") @db.Decimal(14, 3)
  /// CHECK inventory_movements_stock_after_non_negative en SQL — ver docs/db-constraints.md
  stockAfter         Decimal                @map("stock_after") @db.Decimal(14, 3)
  reason             String?                @db.VarChar(500)
  relatedEntityType  String?                @map("related_entity_type") @db.VarChar(50)
  relatedEntityId    String?                @map("related_entity_id") @db.Uuid
  operationKey       String?                @map("operation_key") @db.VarChar(180)
  reversesMovementId String?                @map("reverses_movement_id") @db.Uuid
  createdBy          String                 @map("created_by") @db.Uuid
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  business Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  /// H-07 Fase 2: FK compuesta tenant (SQL NOT VALID; FK simple product_id se conserva en PG)
  product  Product            @relation(fields: [businessId, productId], references: [businessId, id], onDelete: Restrict)
  /// H-07 Fase 4: self-FK tenant (SQL NOT VALID; FK simple reverses_movement_id se conserva en PG)
  reverses InventoryMovement?  @relation("MovementReversal", fields: [businessId, reversesMovementId], references: [businessId, id], onDelete: Restrict)
  reversed InventoryMovement[] @relation("MovementReversal")

  /// H-07 Fase 1: soporte para FK compuestas (business_id, id) incl. self-FK
  @@unique([businessId, id])
  @@unique([businessId, operationKey])
  @@index([businessId, createdAt(sort: Desc)])
  @@index([businessId, productId, createdAt(sort: Desc)])
  @@map("inventory_movements")
}

/// Recepción de compra (inventario). No es factura ni cuenta por pagar.
model PurchaseReceipt {
  id            String   @id @default(uuid()) @db.Uuid
  businessId    String   @map("business_id") @db.Uuid
  supplierName  String   @map("supplier_name") @db.VarChar(180)
  documentRef   String?  @map("document_ref") @db.VarChar(80)
  receivedAt    DateTime @map("received_at") @db.Timestamptz(6)
  notes         String?  @db.VarChar(500)
  /// Idempotencia de la recepción completa (reintentos).
  operationKey  String?  @map("operation_key") @db.VarChar(180)
  createdBy     String   @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  business Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  lines    PurchaseReceiptLine[]

  @@unique([businessId, id])
  @@unique([businessId, operationKey])
  @@index([businessId, receivedAt(sort: Desc)])
  @@map("purchase_receipts")
}

model PurchaseReceiptLine {
  id         String  @id @default(uuid()) @db.Uuid
  businessId String  @map("business_id") @db.Uuid
  receiptId  String  @map("receipt_id") @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  quantity   Decimal @db.Decimal(14, 3)
  unit       String  @db.VarChar(30)
  /// Movimiento ENTRY generado para esta línea.
  movementId String? @map("movement_id") @db.Uuid

  receipt PurchaseReceipt @relation(fields: [businessId, receiptId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, id])
  @@index([businessId, receiptId])
  @@map("purchase_receipt_lines")
}

/// Unicidad parcial documento/NIT en SQL (índices parciales) — docs/db-constraints.md
model Customer {
  id             String       @id @default(uuid()) @db.Uuid
  businessId     String       @map("business_id") @db.Uuid
  type           CustomerType
  status         EntityStatus @default(ACTIVE)
  documentType   String?      @map("document_type") @db.VarChar(20)
  documentNumber String?      @map("document_number") @db.VarChar(40)
  firstName      String?      @map("first_name") @db.VarChar(120)
  lastName       String?      @map("last_name") @db.VarChar(120)
  nit            String?      @db.VarChar(30)
  legalName      String?      @map("legal_name") @db.VarChar(180)
  tradeName      String?      @map("trade_name") @db.VarChar(180)
  contactName    String?      @map("contact_name") @db.VarChar(180)
  phone             String?      @db.VarChar(40)
  email             String?      @db.VarChar(180)
  address           String?      @db.VarChar(240)
  /// Dígito de verificación (NIT u otros); opcional hasta perfil FE.
  verificationDigit String?      @map("verification_digit") @db.VarChar(2)
  /// Municipio (texto libre por ahora; DIVIPOLA pendiente validación).
  municipality      String?      @db.VarChar(120)
  /// Departamento (texto libre por ahora).
  department        String?      @db.VarChar(120)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy         String?      @map("created_by") @db.Uuid
  updatedBy         String?      @map("updated_by") @db.Uuid

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  vehicles      Vehicle[]
  fleets        Fleet[]
  serviceOrders ServiceOrder[]

  /// H-07 Fase 1: soporte para FK compuestas (business_id, id)
  @@unique([businessId, id])
  @@index([businessId, status])
  @@index([businessId, type])
  @@index([businessId, email])
  @@map("customers")
}

model Vehicle {
  id             String       @id @default(uuid()) @db.Uuid
  businessId     String       @map("business_id") @db.Uuid
  customerId     String       @map("customer_id") @db.Uuid
  fleetId        String?      @map("fleet_id") @db.Uuid
  plate          String       @db.VarChar(20)
  vin            String?      @db.VarChar(40)
  brand          String       @db.VarChar(80)
  line           String       @db.VarChar(80)
  model          String?      @db.VarChar(80)
  year           Int?
  vehicleType    String?      @map("vehicle_type") @db.VarChar(40)
  color          String?      @db.VarChar(40)
  fuelType       String?      @map("fuel_type") @db.VarChar(40)
  engineCapacity String?      @map("engine_capacity") @db.VarChar(20)
  version        String?      @db.VarChar(80)
  /// CHECK vehicles_mileage_non_negative en SQL — ver docs/db-constraints.md
  currentMileage Int          @default(0) @map("current_mileage")
  status         EntityStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?      @map("created_by") @db.Uuid
  updatedBy      String?      @map("updated_by") @db.Uuid

  business    Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  /// H-07 Fase 2: FK compuesta tenant (SQL NOT VALID; FK simple customer_id se conserva en PG)
  customer    Customer             @relation(fields: [businessId, customerId], references: [businessId, id], onDelete: Restrict)
  /// H-07 Fase 4: proyección flota tenant (SQL NOT VALID; FK simple fleet_id se conserva en PG). Nullable = sin flota.
  fleet       Fleet?               @relation(fields: [businessId, fleetId], references: [businessId, id], onDelete: Restrict)
  mileageLogs   VehicleMileageLog[]
  assignments   FleetVehicle[]
  serviceOrders ServiceOrder[]

  /// H-07 Fase 1: soporte para FK compuestas (business_id, id)
  @@unique([businessId, id])
  @@unique([businessId, plate])
  @@index([businessId, customerId])
  @@index([businessId, fleetId])
  @@index([businessId, status])
  @@map("vehicles")
}

model VehicleMileageLog {
  id         String        @id @default(uuid()) @db.Uuid
  businessId String        @map("business_id") @db.Uuid
  vehicleId  String        @map("vehicle_id") @db.Uuid
  /// CHECK vehicle_mileage_logs_mileage_non_negative en SQL — ver docs/db-constraints.md
  mileage    Int
  recordedAt DateTime      @default(now()) @map("recorded_at") @db.Timestamptz(6)
  source     MileageSource
  sourceId   String?       @map("source_id") @db.Uuid
  recordedBy String?       @map("recorded_by") @db.Uuid

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  /// H-07 Fase 2: FK compuesta tenant (SQL NOT VALID; FK simple vehicle_id se conserva en PG)
  vehicle  Vehicle  @relation(fields: [businessId, vehicleId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, vehicleId, recordedAt(sort: Desc)])
  @@map("vehicle_mileage_logs")
}

model Fleet {
  id          String       @id @default(uuid()) @db.Uuid
  businessId  String       @map("business_id") @db.Uuid
  customerId  String       @map("customer_id") @db.Uuid
  name        String       @db.VarChar(180)
  description String?
  status      EntityStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy   String?      @map("created_by") @db.Uuid
  updatedBy   String?      @map("updated_by") @db.Uuid

  business    Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  /// H-07 Fase 2: FK compuesta tenant (SQL NOT VALID; FK simple customer_id se conserva en PG)
  customer    Customer       @relation(fields: [businessId, customerId], references: [businessId, id], onDelete: Restrict)
  vehicles    Vehicle[]
  assignments FleetVehicle[]

  /// H-07 Fase 1: soporte para FK compuestas (business_id, id)
  @@unique([businessId, id])
  @@index([businessId, customerId])
  @@index([businessId, status])
  @@index([businessId, name])
  @@map("fleets")
}

/// UNIQUE parcial fleet_vehicles_open_assignment_unique (unassigned_at IS NULL) — docs/db-constraints.md
model FleetVehicle {
  id           String    @id @default(uuid()) @db.Uuid
  businessId   String    @map("business_id") @db.Uuid
  fleetId      String    @map("fleet_id") @db.Uuid
  vehicleId    String    @map("vehicle_id") @db.Uuid
  assignedAt   DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)
  unassignedAt DateTime? @map("unassigned_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  /// H-07 Fase 2: FK compuestas tenant (SQL NOT VALID; FK simples se conservan en PG)
  fleet    Fleet    @relation(fields: [businessId, fleetId], references: [businessId, id], onDelete: Restrict)
  vehicle  Vehicle  @relation(fields: [businessId, vehicleId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, fleetId])
  @@index([businessId, vehicleId])
  @@map("fleet_vehicles")
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum EmailNotificationType {
  BUSINESS_INVITATION
}

/// Trazabilidad de correos transaccionales (sin tokens ni cuerpos completos).
model EmailDelivery {
  id                String                @id @default(uuid()) @db.Uuid
  notificationType  EmailNotificationType @map("notification_type")
  recipient         String                @db.VarChar(255)
  subject           String                @db.VarChar(255)
  status            EmailDeliveryStatus   @default(PENDING)
  provider          String                @db.VarChar(40)
  providerMessageId String?               @map("provider_message_id") @db.VarChar(120)
  attemptCount      Int                   @default(0) @map("attempt_count")
  lastError         String?               @map("last_error") @db.VarChar(500)
  relatedEntityType String?               @map("related_entity_type") @db.VarChar(50)
  relatedEntityId   String?               @map("related_entity_id") @db.Uuid
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt            DateTime?             @map("sent_at") @db.Timestamptz(6)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([recipient])
  @@index([relatedEntityType, relatedEntityId])
  @@index([status, createdAt(sort: Desc)])
  @@map("email_deliveries")
}

/// Catálogo de tipos de servicio por negocio (contrato 05). Sin precio en MVP.
model ServiceType {
  id          String       @id @default(uuid()) @db.Uuid
  businessId  String       @map("business_id") @db.Uuid
  code        String       @db.VarChar(60)
  name        String       @db.VarChar(180)
  category    String?      @db.VarChar(80)
  description String?
  status      EntityStatus @default(ACTIVE)
  /// Parámetros tipados por código (p. ej. defaultEveryKm); no requieren migración.
  parameters  Json?
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy   String?      @map("created_by") @db.Uuid
  updatedBy   String?      @map("updated_by") @db.Uuid

  business Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  items    ServiceOrderItem[]

  /// H-07: soporte FK compuestas (business_id, id) para órdenes futuras
  @@unique([businessId, id])
  @@unique([businessId, code])
  @@index([businessId, status])
  @@index([businessId, name])
  @@map("service_types")
}

/// Órdenes de trabajo (contrato 06). Create no descuenta stock; complete sí.
model ServiceOrder {
  id                       String                @id @default(uuid()) @db.Uuid
  businessId               String                @map("business_id") @db.Uuid
  orderNumber              String                @map("order_number") @db.VarChar(40)
  customerId               String                @map("customer_id") @db.Uuid
  vehicleId                String                @map("vehicle_id") @db.Uuid
  status                   ServiceOrderStatus
  openedAt                 DateTime              @map("opened_at") @db.Timestamptz(6)
  closedAt                 DateTime?             @map("closed_at") @db.Timestamptz(6)
  closedByUserId           String?               @map("closed_by_user_id") @db.Uuid
  mileage                  Int
  nextMaintenanceMileage   Int?                  @map("next_maintenance_mileage")
  nextMaintenanceDate      DateTime?             @map("next_maintenance_date") @db.Date
  maintenanceRule          MaintenanceRuleType?  @map("maintenance_rule")
  observations             String?
  createdBy                String                @map("created_by") @db.Uuid
  operatorUserId           String?               @map("operator_user_id") @db.Uuid
  technicianUserId         String?               @map("technician_user_id") @db.Uuid
  createdAt                DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy                String?               @map("updated_by") @db.Uuid

  business Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customer Customer          @relation(fields: [businessId, customerId], references: [businessId, id], onDelete: Restrict)
  vehicle  Vehicle           @relation(fields: [businessId, vehicleId], references: [businessId, id], onDelete: Restrict)
  items    ServiceOrderItem[]

  @@unique([businessId, id])
  @@unique([businessId, orderNumber])
  @@index([businessId, status, openedAt(sort: Desc)])
  @@index([businessId, vehicleId])
  @@index([businessId, customerId])
  @@map("service_orders")
}

model ServiceOrderItem {
  id              String  @id @default(uuid()) @db.Uuid
  businessId      String  @map("business_id") @db.Uuid
  serviceOrderId  String  @map("service_order_id") @db.Uuid
  serviceTypeId   String  @map("service_type_id") @db.Uuid
  /// Snapshot histórico (no depende del catálogo actual).
  serviceTypeCode String  @map("service_type_code") @db.VarChar(60)
  serviceTypeName String  @map("service_type_name") @db.VarChar(180)
  notes           String?
  position        Int     @default(0)
  /// Extensión mock (16): INITIAL | ADDITIONAL. Opcional en v1 HTTP.
  origin          String? @db.VarChar(20)
  /// Extensión mock: PLANNED | DONE | NOT_PERFORMED | …
  executionStatus String? @map("execution_status") @db.VarChar(40)

  business    Business                   @relation(fields: [businessId], references: [id], onDelete: Restrict)
  order       ServiceOrder               @relation(fields: [businessId, serviceOrderId], references: [businessId, id], onDelete: Restrict)
  serviceType ServiceType                @relation(fields: [businessId, serviceTypeId], references: [businessId, id], onDelete: Restrict)
  productUsages ServiceOrderProductUsage[]

  @@unique([businessId, id])
  @@index([businessId, serviceOrderId])
  @@map("service_order_items")
}

model ServiceOrderProductUsage {
  id                String   @id @default(uuid()) @db.Uuid
  businessId        String   @map("business_id") @db.Uuid
  serviceOrderItemId String  @map("service_order_item_id") @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  /// Snapshot histórico del producto al agregar la línea.
  productName       String   @map("product_name") @db.VarChar(180)
  sku               String?  @db.VarChar(60)
  /// Cantidad prevista (create no reserva stock).
  quantity          Decimal  @db.Decimal(14, 3)
  unit              String   @db.VarChar(30)
  /// Cantidad realmente consumida al cerrar; null → se usa `quantity`.
  quantityConsumed  Decimal? @map("quantity_consumed") @db.Decimal(14, 3)
  unitPrice         Decimal? @map("unit_price") @db.Decimal(14, 2)

  business Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  item     ServiceOrderItem @relation(fields: [businessId, serviceOrderItemId], references: [businessId, id], onDelete: Restrict)
  product  Product          @relation(fields: [businessId, productId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, id])
  @@index([businessId, serviceOrderItemId])
  @@index([businessId, productId])
  @@map("service_order_product_usages")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id") @db.Uuid
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([businessId, createdAt(sort: Desc)])
  @@map("audit_logs")
}
